{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciernet.kz/schemas/central-asia-cascade-basin-event-v1.json",
  "title": "Central Asia Cascade basin event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "basin_id",
    "region",
    "event_type",
    "event_time",
    "event_time_precision",
    "verification_status",
    "sources",
    "split",
    "observation_snapshot"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "basin_id": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "event_type": {
      "enum": ["glof", "debris_flow", "ice_or_rock_avalanche", "compound", "non_event_control"]
    },
    "event_time": {"type": "string", "format": "date-time"},
    "event_time_precision": {"enum": ["minute", "hour", "day", "month", "year", "interval"]},
    "verification_status": {"enum": ["verified", "probable", "control_verified"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation", "url", "accessed_at"],
        "properties": {
          "citation": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "accessed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "split": {"enum": ["development", "temporal_test", "external_test"]},
    "observation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "cutoff_time"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cutoff_time": {"type": "string", "format": "date-time"}
      }
    }
  }
}
