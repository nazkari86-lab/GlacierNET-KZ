# GlacierNET-KZ API — Environment Configuration
# Copy this file to .env and fill in values

# --- Core ---
DATA_DIR=/app/data
REDIS_URL=redis://redis:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:8080,http://127.0.0.1:8080

# --- Upload limits ---
MAX_FILE_SIZE_MB=200
TASK_TIMEOUT=600

# --- Groq evidence assistant ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# The browser can also submit a key for one request; it is never persisted.
GROQ_API_KEY=

# --- Analysis language: en, ru, kk ---
ANALYSIS_LANG=ru

# --- Admin API (optional; protects /api/admin/* when set) ---
ADMIN_API_KEY=

# --- MCP compute boundary ---
# Read-only evidence tools remain available. Enable only on a trusted local
# deployment if AI agents must start real segmentation jobs.
MCP_INFERENCE_ENABLED=false

# --- Optional OSINT / official bulletin connectors ---
# USGS and GDACS require no credentials and are enabled by default.
OSINT_CACHE_TTL_SECONDS=900
OSINT_LOOKBACK_DAYS=30
# Comma-separated RSS/Atom feeds. Full article bodies are never retained.
KAZHYDROMET_OSINT_FEEDS=
GOV_KZ_OSINT_FEEDS=
# ReliefWeb requires a pre-approved appname since 2025-11-01.
RELIEFWEB_APPNAME=
# Optional GDELT Cloud bearer key (gdelt_sk_...).
GDELT_CLOUD_API_KEY=
